# Required: canonical application origin; HTTPS in production.
APP_URL=http://localhost:3001
# Optional additional exact origins for a local/temporary preview. No wildcards.
ADDITIONAL_ALLOWED_ORIGINS=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/rkluxmnl
# Local testing only; demo records are hidden by default.
ENABLE_DEMO_CATALOG=false
# Local Docker only: choose a strong password. Never commit a populated env file.
LOCAL_DB_PASSWORD=

# Optional one-time administrator provisioning. Remove ADMIN_PASSWORD after setup.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Private S3-compatible bucket (Cloudflare R2 recommended).
S3_ENDPOINT=
# Optional externally reachable S3-compatible gateway for signed browser URLs.
# Backend verification still uses S3_ENDPOINT. Leave blank for normal R2/S3.
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
IMAGE_MAX_FILE_BYTES=20971520
REEL_MAX_FILE_BYTES=536870912

# Cloudflare Stream: private, server-side credentials only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
# Optional customer-<code>.cloudflarestream.com host; blank uses Cloudflare's
# universal signed iframe player.
CLOUDFLARE_STREAM_DELIVERY_HOST=
# Match the account's supported limits and purchased capacity. This is a
# configurable reservation, not a hardcoded four-hour restriction.
STREAM_MAX_FILE_BYTES=30000000000
STREAM_MAX_DURATION_SECONDS=21600

# Enable only behind a trusted proxy that replaces client-supplied IP headers.
TRUST_PROXY=false
# Optional Cloudflare Turnstile; configure BOTH keys together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GOOGLE_SITE_VERIFICATION=
